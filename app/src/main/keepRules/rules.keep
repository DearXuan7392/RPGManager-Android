# ---------------------------------------------------------------------------
# 内嵌 Node 运行时的 JNI 入口。
# 原生库里的符号名是 Java_com_dearxuan_rpgmanager_node_NodeLauncher_xxx，
# 类名/包名/方法名任一被混淆，System.loadLibrary 之后就再也找不到方法。
# ---------------------------------------------------------------------------
-keep class com.dearxuan.rpgmanager.node.NodeLauncher { *; }

# ---------------------------------------------------------------------------
# 页面通过 window.RPGHost 调用这个接口（JavascriptInterface 按方法名反射查找），
# 混淆后方法名会变，release 包里「作弊面板打开时收起虚拟按键」就会失效。
# ---------------------------------------------------------------------------
-keep class com.dearxuan.rpgmanager.core.PageHost { *; }
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}
